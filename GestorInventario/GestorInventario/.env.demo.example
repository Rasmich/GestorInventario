# Plantilla sin valores. No introducir credenciales de la base real.
DEMO_DB_PASSWORD=
# Base64 de un minimo de 32 bytes aleatorios; no una frase ni texto sin codificar.
DEMO_JWT_SECRET=

# Cuatro contrasenas nuevas y distintas: 8 caracteres minimo, 72 bytes UTF-8 maximo.
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE1_PASSWORD=
DEMO_EMPLOYEE2_PASSWORD=
DEMO_EMPLOYEE3_PASSWORD=
